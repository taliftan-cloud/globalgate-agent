# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port the Express interface listens on
PORT=4002

NODE_ENV=development

# Optional (Step 3 guardrail) — landed-cost calculations whose buyer
# out-of-pocket total exceeds this trigger a human-approval pause.
# Defaults to 5000 if not set.
HIGH_COST_THRESHOLD_USD=5000
